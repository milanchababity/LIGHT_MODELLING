#!/bin/bash
cd /home/didier/Bureau/Romain/partage/PAR_FSPM

# Balayage du repertoire de *.par
for file in ./FetuqueAlfa/PAR/Profils_Horizontaux/*
do
	fich="${file}"
	dname=`dirname ${fich}`
	dcname=$dname/../../CAN_F/Profils_Horizontaux
	# Gets basename excluding the extension
	tmpname=`basename ${fich} .par`
	# lookup a file.can = $canname
	canname=$dcname/${tmpname:0:12}_F.can
	cp $canname $dname/../../../fort.51
	./s2v < $dname/$tmpname.par > $dcname/../../LOG_F/Profils_Horizontaux/$tmpname.log
done
